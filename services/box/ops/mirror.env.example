# services/box/ops/mirror.env.example
# Lives on the MAC as ~/.lares/mirror.env (chmod 0400) and is sourced by
# mirror-and-prune.sh. The Mac is the trusted side: it mirrors the off-provider copy
# and is the ONLY place that prunes retention. Fill at deploy time.

# --- Hetzner Storage Box, reached with the PRUNE key (NOT the append-only one) ---
# Pruning deletes history, so it needs a second authorized_keys line on the Storage Box
# WITHOUT --append-only (Stage 1.5 plan Task 2). This key lives only on the Mac.
STORAGEBOX_HOST=uNNNNNN.your-storagebox.de
STORAGEBOX_USER=uNNNNNN
STORAGEBOX_PORT=23
STORAGEBOX_SSH_KEY=~/.lares/secrets/storagebox_prune   # full (non-append) key, Mac only
RESTIC_REPO_PATH=box-backup
RESTIC_PASSWORD_FILE=~/.lares/secrets/restic-password   # same password as the box

# --- Scaleway off-provider mirror (bucket versioning = deletes/overwrites recoverable; copy-only) ---
SCW_REGION=fr-par
SCW_BUCKET=lares-dr-backup
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
