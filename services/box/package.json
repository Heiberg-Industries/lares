{
  "name": "@lares/agent-box",
  "version": "0.1.0",
  "description": "The private agent box's state store: Postgres + pgvector + pg-boss. Schema, Compose stack, and a typed data layer (sessions, confirmations, reminders, schedules, audit). Deployed to lares-agent-1; never built on the box.",
  "private": true,
  "type": "module",
  "main": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./lib/oauth-tokens.js": "./lib/oauth-tokens.ts",
    "./lib/notion-proposals.js": "./lib/notion-proposals.ts",
    "./lib/crypto.js": "./lib/crypto.ts",
    "./lib/migration-ledger.js": "./lib/migration-ledger.ts",
    "./lib/migration-runner.js": "./lib/migration-runner.ts",
    "./tests/helpers/pg.js": "./tests/helpers/pg.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx migrate.ts",
    "erase-person": "tsx bin/erase-person.ts",
    "first-owner": "tsx bin/first-owner.ts",
    "installation-settings": "tsx bin/installation-settings.ts",
    "render-stack": "tsx bin/render-stack.ts",
    "render-keeper-config": "tsx bin/render-keeper-config.ts",
    "export-person": "tsx bin/export-person.ts",
    "doctor": "tsx bin/doctor.ts"
  },
  "dependencies": {
    "@lares/network": "workspace:^",
    "@lares/vault-format": "workspace:^",
    "better-sqlite3": "^11.7.0",
    "pg": "^8.21.0",
    "pg-boss": "^10.1.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.0"
  },
  "license": "AGPL-3.0-only"
}
